{
  "name": "regularly-scheduled-syndication",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build.ts",
    "predev": "npm run build",
    "test:browser": "playwright test",
    "check:staging": "wrangler deploy --dry-run",
    "migrate:staging": "wrangler d1 migrations apply regsched-staging --remote",
    "deploy:staging": "wrangler deploy",
    "check:production": "wrangler deploy --config wrangler.production.jsonc --dry-run",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "migrate:production": "wrangler d1 migrations apply regsched-production --config wrangler.production.jsonc --remote"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "entities": "^8.1.0",
    "hono": "^4.13.19",
    "ipaddr.js": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@hono/node-server": "^2.1.9",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1",
      "sharp": "^0.35.5"
    }
  },
  "license": "MIT"
}
