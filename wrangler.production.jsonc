{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regsched-production",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "npm run build"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "ORIGIN": "https://regsched.example.com",
    "RP_ID": "regsched.example.com",
    "APP_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "regsched-production",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FEEDS",
      "bucket_name": "regsched-production-feeds"
    }
  ],
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "regsched.example.com",
      "custom_domain": true
    }
  ]
}
